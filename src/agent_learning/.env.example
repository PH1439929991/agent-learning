DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=your_api_url_here
DEEPSEEK_MODEL=your_model_name_here

# 模块八第五节：独立的 Embedding 服务配置（填写到本地 .env）。
# 三项必须属于同一家服务；不要把其他平台的密钥发送到不匹配的地址。
# 服务须兼容 OpenAI /embeddings 接口，并支持所填写的 Embedding 模型。
# BASE_URL 填 API 根地址，不要把 /embeddings 路径拼进去。
# 若使用 OpenAI 官方服务：BASE_URL=https://api.openai.com/v1，
# 模型可填 text-embedding-3-small，密钥必须来自对应 OpenAI API 账户。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
